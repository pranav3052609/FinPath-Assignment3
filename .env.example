# ─── Supabase Configuration ───────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
# ──────────────────────────────────────────────────────────────────────────────

# Public URL of your Supabase project
SUPABASE_URL=https://your-project-id.supabase.co

# Public "anon" key — safe to expose in frontend (protected by RLS)
SUPABASE_ANON_KEY=your_publishable_key

# Secret "service_role" key — NEVER expose to the frontend or commit to Git
SUPABASE_SERVICE_ROLE_KEY=your_secret_key

# ─── Vite / Frontend ─────────────────────────────────────────────────────────
# These VITE_ prefixed variables are embedded into the frontend build.
# They MUST match the backend values above.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1